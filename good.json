  "commands": [
    {
      "Name": "keys-generate",
      "Network": "all",
      "Purpose": "keys",
      "Description": "Generate a fresh keypair for signing (write to a safe location)",
      "Cmd": "kda-tool keygen -o \u003ckey.yaml\u003e",
      "Docs": "https://github.com/kda-community/kda-tool",
      "Verify": ""
    },
    {
      "Name": "deploy-module-mainnet",
      "Network": "mainnet01",
      "Purpose": "deploy",
      "Description": "Deploy a Pact module to mainnet01 on a chosen chain",
      "Cmd": "kda-tool deploy --network mainnet01 --chain \u003cn\u003e --signer \u003ckey.yaml\u003e --code \u003cmodule.pact\u003e",
      "Docs": "https://github.com/kda-community/kda-tool",
      "Verify": "TODO: verify exact flag names against kda-tool --help"
    },
    {
      "Name": "deploy-module-testnet",
      "Network": "testnet06",
      "Purpose": "deploy",
      "Description": "Deploy a Pact module to testnet06 on a chosen chain",
      "Cmd": "kda-tool deploy --network testnet06 --chain \u003cn\u003e --signer \u003ckey.yaml\u003e --code \u003cmodule.pact\u003e",
      "Docs": "https://github.com/kda-community/kda-tool",
      "Verify": "TODO: verify exact flag names against kda-tool --help"
    },
    {
      "Name": "query-list-modules",
      "Network": "all",
      "Purpose": "query",
      "Description": "List deployed modules on a chain via Pact /local",
      "Cmd": "sot local \u003cnetwork\u003e \u003cchain\u003e '(list-modules)'",
      "Docs": "https://kda-chain.org/docs/",
      "Verify": ""
    },
    {
      "Name": "faucet-testnet06",
      "Network": "testnet06",
      "Purpose": "faucet",
      "Description": "Request testnet06 coins via the community faucet",
      "Cmd": "open https://tools.chainweb-community.org/faucet/new",
      "Docs": "https://kda-chain.org/docs/",
      "Verify": ""
    },
    {
      "Name": "node-start-mainnet",
      "Network": "mainnet01",
      "Purpose": "node",
      "Description": "Bootstrap a chainweb-node against the community mainnet",
      "Cmd": "chainweb-node --config \u003cchainweb-node.yaml\u003e",
      "Docs": "https://github.com/kda-community/chainweb-node",
      "Verify": ""
    },
    {
      "Name": "node-start-testnet",
      "Network": "testnet06",
      "Purpose": "node",
      "Description": "Bootstrap a chainweb-node against testnet06",
      "Cmd": "chainweb-node --config \u003cchainweb-testnet06.yaml\u003e",
      "Docs": "https://github.com/kda-community/testnet06",
      "Verify": ""
    }
  ],
